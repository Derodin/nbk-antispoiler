package-as: NerzorsBlacklistKeeper_AntiSpoiler

required-dependencies:
  - nerzorsblacklistkeeper

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .tools
  - tests
  - screenshots
  - antispoiler_dev
  - README.md
  - CHANGELOG.md
  - build-release.ps1
